{
  "name": "borrowbox",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20" },
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @borrowbox/api run dev",
    "dev:web": "npm --workspace @borrowbox/web run dev",
    "build": "npm run build --workspace @borrowbox/api && npm run build --workspace @borrowbox/web",
    "typecheck": "npm run typecheck --workspace @borrowbox/api && npm run typecheck --workspace @borrowbox/web",
    "db:generate": "npm --workspace @borrowbox/api run db:generate",
    "db:validate": "npm --workspace @borrowbox/api run db:validate",
    "db:migrate:dev": "npm --workspace @borrowbox/api run db:migrate:dev",
    "db:migrate:deploy": "npm --workspace @borrowbox/api run db:migrate:deploy",
    "db:seed": "npm --workspace @borrowbox/api run db:seed",
    "test": "npm run test --workspace @borrowbox/api"
  },
  "devDependencies": { "concurrently": "^9.1.2", "typescript": "^5.7.3" }
}
