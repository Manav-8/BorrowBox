# Copy to apps/api/.env for local API development. Never commit actual .env files.
NODE_ENV=development
# Obtain the PostgreSQL URLs in Supabase: Project Settings > Database > Connection string.
# DATABASE_URL: shared Session pooler connection string (Connect button > Session pooler).
# Use the copied pooler host/user/port (usually port 5432); never compose the host manually.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"
# DIRECT_URL: direct database connection string for Prisma migrations when the runner can reach it.
# On IPv4-only networks, use the Session pooler string here too.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Generate a long random value locally (at least 32 bytes); never use the example value.
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
# Local API port and allowed browser origin. Set WEB_ORIGIN to the deployed Vercel URL in production.
PORT=4000
WEB_ORIGIN="http://localhost:5173"
# API_BASE_URL is a public URL used by the frontend build, not a credential.
VITE_API_BASE_URL="http://localhost:4000"

# Supabase Storage: Project Settings > API provides project URL and service-role key.
# Keep the service-role key exclusively in the backend environment.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"
SUPABASE_STORAGE_BUCKET="listing-images" 

# Optional demo seed: only set true after registering an account and using its own user id below.
# The seed script creates a listing and request, never sample accounts or passwords.
SEED_DEMO_DATA=false
SEED_OWNER_ID=""

# Razorpay Dashboard > Account & Settings > API Keys (use TEST MODE keys).
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace-with-test-mode-key-secret"
# Razorpay Dashboard > Webhooks; configure the endpoint /api/payments/webhook.
RAZORPAY_WEBHOOK_SECRET="replace-with-webhook-signing-secret"

# Optional: Vercel deployment is configured through its dashboard; do not put provider tokens here.
