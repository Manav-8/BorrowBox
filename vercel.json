{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace @borrowbox/web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://borrowbox-3mhu.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
